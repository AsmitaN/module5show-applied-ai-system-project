classDiagram
    %% Core Design
    class Owner {
        +name: str
        +pets: List~Pet~
        +scheduler: Scheduler
        +task_validator: TaskValidator
        +add_pet(pet) None
    }

    class Pet {
        +name: str
        +species: str
        +tasks: List~Task~
        +get_name() str
        +get_info() str
    }

    class Task {
        +description: str
        +duration: int
        +frequency: str
        +priority: str
        +time: str
        +due_date: date
        +completion_status: str
        +get_priority_level() int
        +get_info() str
        +mark_complete() None
    }

    %% Scheduling & Task Feedback
    class Scheduler {
        +pets: List~Pet~
        +tasks: List~Task~
        +add_task(pet_name, task) bool
        +retrieve_all_tasks() None
        +filter_tasks(status, pet_name) List~Task~
        +sort_by_time(pets) List~Task~
        +check_scheduling_conflicts(pet_name, task) bool
        +print_schedule(pets, schedule) None
    }

    class TaskValidator {
        +scheduler: Scheduler
        +tasks: List~Task~
        +times_overlap(start1, dur1, start2, dur2) bool
        +find_occupied_times(due_date) List~str~
        +prepare_conflict_summary(pet_name, task) dict
        +get_recommendation_prompt(analysis_context) str
    }

    %% AI Integration Component
    class GeminiClient {
        +get_client_recommendation(prompt) str
    }

    %% Data Flow & Relationships
    Owner *-- Pet : owns
    Owner *-- Scheduler : has
    Owner *-- TaskValidator : has
    Pet *-- Task : contains
    Scheduler --> Pet : manages
    Scheduler --> Task : schedules
    TaskValidator --> Scheduler : uses to check conflicts
    TaskValidator --> GeminiClient : sends prompt for recommendation
    GeminiClient --> TaskValidator : returns AI recommendation
    